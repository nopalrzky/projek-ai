/* Custom Multi-select Dropdown Styles */
.custom-select-multiselect {
    position: relative;
    width: 100%; /* Atau sesuaikan dengan lebar yang diinginkan */
    min-width: 150px;
    margin-top: 6px; /* Tambahkan ini agar konsisten dengan input lain */
}

.custom-select-multiselect .select-selected {
    background-color: #fff;
    padding: 10px;
    border: 1px solid var(--line); /* Gunakan var(--line) untuk konsistensi */
    cursor: pointer;
    user-select: none;
    border-radius: 9px;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    min-height: 40px;
    overflow: hidden;         /* Sembunyikan teks yang meluber */
    text-overflow: ellipsis;  /* Ganti dengan ... jika terlalu panjang */
    white-space: nowrap;      /* Pastikan teks tidak pecah baris */
    color: var(--ink); /* Pastikan teks terlihat */
}

.custom-select-multiselect .select-selected:after {
    position: absolute;
    content: "";
    top: 50%; /* Pusatkan secara vertikal */
    transform: translateY(-50%); /* Penyesuaian agar benar-benar di tengah */
    right: 10px;
    width: 0;
    height: 0;
    border: 6px solid transparent;
    border-color: #666 transparent transparent transparent;
}

.custom-select-multiselect .select-selected.select-arrow-active:after {
    border-color: transparent transparent #666 transparent;
    top: 50%; /* Pastikan tetap di tengah saat aktif */
    transform: translateY(-50%) rotate(180deg); /* Panah berputar saat aktif */
}

.custom-select-multiselect .select-items {
    position: absolute;
    background-color: #fff;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 99;
    border: 1px solid var(--line); /* Gunakan var(--line) */
    border-top: none;
    max-height: 200px;
    overflow-y: auto;
    border-radius: 0 0 4px 4px; /* Gunakan 4px agar konsisten, tapi bisa disesuaikan */
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
}

.custom-select-multiselect .select-items label {
    padding: 10px;
    padding-left: 10px;
    margin-left: 0;
    cursor: pointer;
    display: flex; /* Gunakan flex untuk layout checkbox dan teks */
    align-items: center;
    gap: 8px; /* Jarak antara checkbox dan teks label */
}

.custom-select-multiselect .select-items label:hover {
    background-color: #f1f1f1;
}

.custom-select-multiselect .select-items label input[type="checkbox"] {
    margin: 0; /* Hapus margin default */
    vertical-align: middle; /* Sejajarkan secara vertikal */
    transform: scale(1.1); /* Sedikit membesarkan checkbox agar lebih terlihat */
    accent-color: var(--green); /* Warna centang */
}

.select-hide {
    display: none;
}

